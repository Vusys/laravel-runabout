{
    // Mutation testing config for Infection.
    //
    // Measured MSI / Covered-MSI is 96.39% (mutation code coverage 100%);
    // the ~40 survivors are all proven-equivalent mutants (variadic
    // array_values() no-ops, dead ?? fallbacks, unreachable catch blocks,
    // RNG-bound ±1). `minMsi` / `minCoveredMsi` sit a couple of points
    // below the measured number so a genuine regression fails CI while
    // adding a new equivalent doesn't. Ratchet them up as the score climbs.
    $schema: "vendor/infection/infection/resources/schema.json",
    source: {
        directories: ["src"],
    },
    timeout: 30,
    logs: {
        text: "build/infection/infection.log",
        html: "build/infection/infection.html",
        json: "build/infection/infection.json",
        summary: "build/infection/summary.log",
        github: true,
        stryker: {
            // Branch name pattern — Infection uploads to the Stryker
            // dashboard only when running on a matching branch. Master
            // is enough; PR diff runs would pollute the dashboard with
            // partial measurements.
            report: "master",
        },
    },
    mutators: {
        "@default": true,
        // JourneyRunner::runCanonical()'s round-robin loop is bounded by
        // array_key_exists() at every position for every instance, so
        // nudging the loop's start (0 -> -1) or end (< -> <=) by one is
        // unobservable: the guard turns the extra position into a no-op for
        // every instance. Proven-equivalent, the same class of survivor the
        // full run already tolerates (see the note above) — but the
        // PR-diff run has no headroom to absorb a new one, so these are
        // named explicitly instead.
        LessThan: {
            ignore: ["Vusys\\Runabout\\JourneyRunner::runCanonical"],
        },
        DecrementInteger: {
            ignore: ["Vusys\\Runabout\\JourneyRunner::runCanonical"],
        },
    },
    minMsi: 94,
    minCoveredMsi: 94,
    testFramework: "phpunit",
    tmpDir: "build/infection",
}
