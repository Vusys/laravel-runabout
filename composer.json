{
    "name": "vusys/laravel-runabout",
    "description": "Journey testing for Laravel: run the steps of a user journey in seeded, shuffled orders and assert invariants along the way.",
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.3",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.0",
        "larastan/larastan": "^2.9|^3.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^11.0|^12.0",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Vusys\\Runabout\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vusys\\Runabout\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "analyse": "phpstan analyse",
        "analyze": "@analyse",
        "rector": "rector process",
        "rector:check": "rector process --dry-run",
        "pint": "pint",
        "pint:check": "pint --test",
        "check": [
            "@pint:check",
            "@rector:check",
            "@analyse"
        ],
        "test": "phpunit"
    },
    "scripts-descriptions": {
        "check": "Run every non-test gate (Pint --test, Rector --dry-run, PHPStan level 9) in one go. Halts on the first failure. Matches what CI's static-analysis job runs — pass this locally before pushing."
    }
}
